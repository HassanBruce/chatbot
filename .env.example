# Meta → App → WhatsApp → API Setup (temporary token) / System User token (permanent)
WHATSAPP_TOKEN=
# Any random string. Same value goes in Meta → Configuration → Verify token
VERIFY_TOKEN=change-me-random-string
# Meta → App settings → Basic → App secret (verifies webhooks really come from Meta)
APP_SECRET=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# One model, or several separated by commas: if one is rate-limited/overloaded, the next one answers
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite,gemma-4-26b-a4b-it
# Give up on a Gemini request after this long and send the fallback reply
GEMINI_TIMEOUT_MS=25000
GRAPH_VERSION=v25.0
PORT=3000

# Clients in their OWN WhatsApp account get their own token:
# TOKEN_BUTT_KARAHI=
