# --- Server ---
PORT=3000
DOMAIN=bot.yourdomain.com
# Business local time (used for "abhi open ho?", "kal 5 baje")
TZ_BUSINESS=Asia/Karachi

# --- WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp) ---
# Any long random string; paste the same value in Meta's webhook settings
WA_VERIFY_TOKEN=change-me-random-string
# App settings → Basic → App secret (verifies webhooks really come from Meta). REQUIRED in production.
WA_APP_SECRET=
# Default token (Meta test number / your own number). Numbers connected via /onboard store their own token.
WA_ACCESS_TOKEN=
WA_GRAPH_VERSION=v23.0

# --- Embedded Signup: clients connect their own number (incl. coexistence with WhatsApp Business app) ---
META_APP_ID=
# WhatsApp → Embedded Signup → create configuration → its Configuration ID
ES_CONFIG_ID=

# --- Owner alerts outside 24h window (optional): approved UTILITY template with ONE body variable {{1}} ---
OWNER_ALERT_TEMPLATE=
OWNER_ALERT_TEMPLATE_LANG=en

# --- AI (any OpenAI-compatible API) ---
# Gemini: get a key at aistudio.google.com. Use a PAID key for real clients.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-2.5-flash-lite
AI_TIMEOUT_MS=25000
HISTORY_LIMIT=16

# --- Behaviour ---
# Wait this long for the customer to finish typing before replying once
DEBOUNCE_MS=2500
# Per customer; protects your AI bill from spam
MAX_MSGS_PER_HOUR=40
# Bot stays quiet after handoff / after the owner replies from the WhatsApp Business app
HANDOFF_PAUSE_HOURS=6
OWNER_REPLY_PAUSE_HOURS=12
# Owner ends an app message with this → bot takes the chat back
BOT_RESUME_MARKER=🤖
MEDIA_DOWNLOAD=true
MEDIA_MAX_MB=16

# --- Dashboard: https://DOMAIN/admin (any username + this password, min 12 chars) ---
ADMIN_PASSWORD=change-me-strong-password
BACKUP_KEEP_DAYS=14
