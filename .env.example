# Meta → App → WhatsApp → API Setup (temporary token) / System User token (permanent)
WHATSAPP_TOKEN=
# Any random string. Same value goes in Meta → Configuration → Verify token
VERIFY_TOKEN=change-me-random-string
# Meta → App settings → Basic → App secret (verifies webhooks really come from Meta)
APP_SECRET=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GRAPH_VERSION=v25.0
PORT=3000

# Clients in their OWN WhatsApp account get their own token:
# TOKEN_BUTT_KARAHI=
